{
  "name": "all-the-tokens-board-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test",
    "db:migrate:local": "wrangler d1 migrations apply tokens-board --local",
    "dev": "wrangler dev --local --var ACTOR_HASH_PEPPER:local-development-only-pepper-0001 --var WRITE_MODE:open",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  }
}
